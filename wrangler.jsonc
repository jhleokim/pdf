{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pdf",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  // Keep Gemini requests near a supported Google Cloud region instead of an arbitrary edge location.
  // Static assets continue to be served near the visitor.
  "placement": {
    "region": "gcp:us-east4"
  },
  "build": {
    "command": "node scripts/build.mjs && node scripts/build-deploy.mjs"
  },
  "assets": {
    "directory": "./.deploy",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ratelimits": [
    {
      "name": "OCR_RATE_LIMIT",
      "namespace_id": "39082026",
      "simple": {
        "limit": 15,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.8-flash",
    "GEMINI_FALLBACK_MODEL": "gemini-3.7-flash"
  }
}
