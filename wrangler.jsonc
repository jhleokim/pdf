{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pdf",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "build": {
    "command": "node scripts/build.mjs && node scripts/build-deploy.mjs"
  },
  "assets": {
    "directory": "./.deploy",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ratelimits": [
    {
      "name": "OCR_RATE_LIMIT",
      "namespace_id": "39082026",
      "simple": {
        "limit": 15,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.8-flash"
  }
}
